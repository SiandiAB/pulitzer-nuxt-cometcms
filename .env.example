# Copie este archivo a .env y complete con los valores de su espacio en
# http://cms-una.gt.tc (no se sube al repositorio, ver .gitignore).
# NUXT_COMET_API_TOKEN queda vacío: en el espacio del curso los content
# types son de lectura pública para estudiantes (no hay opción de generar
# token ni marcar Private), así que no hace falta.
NUXT_COMET_API_TOKEN=
NUXT_COMET_URL=https://cms-una.gt.tc
NUXT_COMET_WORKSPACE=premios-pulitzer
